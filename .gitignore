# Entornos virtuales
.venv/
env/
venv/
ENV/

# Archivos de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Variables de entorno
.env
.env.local
.env.*.local

# Bases de datos y almacenamiento local
data/*.duckdb
data/*.db

# Corpus del eCFR: 21,7 MB que se regeneran con `python -m etl.ingerir_ecfr`.
# Es una copia de la distribucion oficial del GPO, no fuente de este repo.
data/ecfr/

# Anexo II de la UE: 3,4 MB de HTML de EUR-Lex mas 5,8 MB de JSON derivado.
# Se regeneran con `python -m etl.ingerir_anexo_ii`.
data/ue/
logs/
*.db
*.db-wal
*.db-shm

# Informes generados (Markdown y PDF)
informes/*
!informes/.gitkeep

#vectores
vectores/*

# IDEs y Editores
.vscode/
.idea/
*.code-workspace

# Archivos de sistema operativo
.DS_Store
Thumbs.db

# Scripts de prueba temporales
scratch_test.py
check_tokens.py
