# ============================================================
#  AgroScout IA — variables de entorno
#  Copia este archivo a .env y rellena los valores.
#  .env está en .gitignore: NUNCA se sube al repositorio.
# ============================================================

# --- LLM (Huawei ModelArts MaaS) — ya en uso desde S1 -------
HUAWEI_MAAS_API_KEY=tu_api_key_de_huawei_aqui
HUAWEI_MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1

# --- Datos y APIs externas (ETL de S2, búsqueda S10) ---------
USDA_API_KEY=tu_usda_api_key_aqui
TAVILY_API_KEY=tu_tavily_api_key_aqui
BRAVE_SEARCH_API_KEY=tu_brave_search_api_key_aqui
BRIGHT_DATA_KEY=tu_bright_data_key_aqui
# Zona de Web Unlocker, usada como reserva cuando una tienda responde 403.
# La clave sola NO basta: hace falta una zona creada en el panel de Bright Data.
# Sin ella, cada peticion vuelve con HTTP 200 y cero bytes, y la cabecera
# x-brd-err-code: client_10002 lo explica. Ver TIERSV3/S8_GONDOLA_ALEMANIA.md §5.6
BRIGHT_DATA_ZONE=web_unlocker1

# --- Modo offline (plan B de la demo) -----------------------
AGROSCOUT_OFFLINE=0

# ============================================================
#  SEMANA 3 · Supabase
#  Dónde sacar cada valor está en PLAN-TIERS-S3.md §0.
# ============================================================

# 1) Dashboard > Project Settings > API  (o "API Keys")
#    URL del proyecto. Termina en .supabase.co, sin barra final.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# 2) Clave PÚBLICA. En proyectos nuevos se llama sb_publishable_...
#    En proyectos anteriores se llama "anon public".
#    Se usa para el login (password grant). Puede ser vista por terceros.
SUPABASE_ANON_KEY=

# 3) Clave SECRETA. En proyectos nuevos se llama sb_secret_...
#    En proyectos anteriores se llama "service_role secret".
#    Salta RLS: SOLO en el backend. Nunca en el frontend ni en git.
#    El codigo acepta los dos nombres; basta rellenar UNO de los dos.
#    Este proyecto usa el esquema nuevo: el valor esta en SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# 4) Dashboard > Connect > Transaction pooler (puerto 6543).
#    Copiar la cadena TAL CUAL y reemplazar [YOUR-PASSWORD] por la
#    contraseña de la base de datos (NO es ninguna de las claves de arriba).
#    Si la contraseña tiene @ : / ? # hay que URL-encodearla.
#    La conexión directa (db.<ref>.supabase.co:5432) resuelve SOLO en IPv6:
#    funciona desde una red con IPv6, pero muere en una red IPv4 pura.
#    scripts/verificar_supabase.py avisa si la cadena no es la del pooler.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# 5) DECIDIDO EN T1.2 (2026-08-02): este proyecto firma con ES256 y publica
#    su JWKS en /auth/v1/.well-known/jwks.json. La verificacion es por JWKS,
#    asi que esta variable NO se usa y se deja VACIA. Se conserva por si el
#    despliegue se mueve a un proyecto con firma HS256 heredada.
SUPABASE_JWT_SECRET=

# 6) Bucket privado para los PDF. Se crea en TIER 1.
SUPABASE_BUCKET_INFORMES=informes

# 7) Backend de estado de aplicación: supabase | sqlite
#    sqlite = plan B de la demo, sigue funcionando sin internet.
APP_DB=supabase

# 8) Archivo de la rama sqlite. Se deja como está salvo que quieras aislar
#    una prueba: agroscout.db está versionado, así que escribir en él deja
#    un binario de ~1 MB modificado en git.
AGROSCOUT_DB_PATH=agroscout.db

# --- Cache y observabilidad (S1) -----
# Redis para cache de búsquedas (opcional en MVP, requerido en S10)
REDIS_URL=redis://localhost:6379

# Debug mode: activa logs verbosos (true | false)
DEBUG=true

# --- Presupuestos y kill-switch (TIER 6) --------------------
#
# MEDIDO el 2026-08-02: un run premium en frío cuesta US$ 0,19-0,23 (5 etapas,
# tres de ellas con glm-5.2). Con estos topes eso son ~1 run contra el tope por
# run y ~45 al mes contra el global, para toda la institución. Los valores se
# escribieron cuando la etapa 3 usaba glm-5.0, once veces más barato.
# Ver PLAN-TIERS-S3.md §T5 para las tres palancas de coste.
PRESUPUESTO_RUN_USD=0.25

# Tope mensual del plan gratuito. Lo aplica el entitlement (T6.1), no el
# adaptador: cambiar aquí cambia lo que puede gastar una cuenta gratuita.
PRESUPUESTO_USUARIO_MES_USD=2

# Tope mensual del plan premium.
PRESUPUESTO_PREMIUM_MES_USD=10

# Kill-switch: al superarse, NADIE ejecuta LLM. Ponerlo en 0 es la forma de
# apagar el gasto en caliente; los runs siguen devolviendo 200 con informe
# parcial y motivo 'presupuesto'.
PRESUPUESTO_GLOBAL_MES_USD=10

# --- Legado: solo se usa con APP_DB=sqlite ------------------
JWT_SECRET_KEY=cambiar-en-produccion
